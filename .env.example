YIJI_APP_TITLE=Yiji
YIJI_PORT=8100
YIJI_RELOAD=true
# Local folder for the bank session and cached transactions (default: .yiji/)
YIJI_DATA_DIR=

# sandbox (default; Mock ASPSP, used by tests) or production (real bank)
YIJI_ENABLE_BANKING_ENVIRONMENT=sandbox
# Must be registered as redirect URLs in the Enable Banking control panel.
# Sandbox: the app serves this itself, so YIJI_PORT must match and https needs a certificate.
YIJI_ENABLE_BANKING_SANDBOX_REDIRECT_URL=https://localhost:8100/callback
# Production: hosted page (public repo yiji-site) that relays back to the local app.
YIJI_ENABLE_BANKING_REDIRECT_URL=https://sovernDK.github.io/yiji-site/callback.html
# Local HTTPS certificate: generate with `uv run python -m app.tls`
YIJI_SSL_CERTFILE=
YIJI_SSL_KEYFILE=
# Bank to connect: Mock ASPSP / FI in sandbox; your bank's name and country in production
YIJI_ENABLE_BANKING_ASPSP_NAME=Mock ASPSP
YIJI_ENABLE_BANKING_ASPSP_COUNTRY=FI
YIJI_ENABLE_BANKING_CONSENT_DAYS=90
YIJI_TRANSACTIONS_REFRESH_MINUTES=360
# History asked for when the bank refuses a year (Y2Y needs ~13 months); at least 30
YIJI_TRANSACTIONS_FALLBACK_HISTORY_DAYS=90

ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=

ENABLE_BANKING_SANDBOX_ID=
ENABLE_BANKING_SANDBOX_KEY_PATH=
