# Install as described in docs/wiki.html ("Server"). Exit code 2 means the bank needs
# reconnecting in Yiji. The backup runs even when the sync fails; the sync's exit code is kept.
[Unit]
Description=Store the latest Yiji bank payments and exchange rates, then back them up
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/yiji
ExecStart=/bin/sh -c 'docker compose run --rm --no-deps yiji python -m app.sync; status=$?; docker compose run --rm --no-deps yiji python -m app.backup; exit $status'
