# Copy to .env next to docker-compose.yml on the server.

# Docker network your Caddy container is on (docker network ls)
CADDY_NETWORK=
# Where you open Yiji; the bank callback is relayed here
YIJI_PUBLIC_URL=https://yiji.home.net
# Signs browser sessions: openssl rand -hex 32
YIJI_STORAGE_SECRET=
TZ=Europe/Warsaw

YIJI_DEFAULT_LANGUAGE=pl
YIJI_ENABLE_BANKING_ENVIRONMENT=production
YIJI_ENABLE_BANKING_ASPSP_NAME=Bank Pekao
YIJI_ENABLE_BANKING_ASPSP_COUNTRY=PL
# Pekao allows 180 days
YIJI_ENABLE_BANKING_CONSENT_DAYS=180
YIJI_RECONNECT_WARNING_DAYS=7
# Pekao serves 90 days of history
YIJI_TRANSACTIONS_FALLBACK_HISTORY_DAYS=90
YIJI_BACKUP_KEEP=14

# Production app id from the Enable Banking control panel; its key goes in secrets/enable-banking.pem
ENABLE_BANKING_APP_ID=
